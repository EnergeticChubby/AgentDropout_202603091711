    }
  },
  "AcEdBYx2ixx3": {
    "proposition_id": "AcEdBYx2ixx3",
    "text": "This inequality comes from the fact that the maximum dimension of \\(V + W\\) is the dimension of the whole space \\(X\\), which is 7",
    "source_node": "YZ8M",
