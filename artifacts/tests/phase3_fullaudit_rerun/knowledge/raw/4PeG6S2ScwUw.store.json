  "f6vvM7JkfiM6": {
    "proposition_id": "f6vvM7JkfiM6",
    "text": "A key concept here is the dimension of the intersection of two subspaces",
    "source_node": "YZ8M",
    "source_role": "Knowlegable Expert",
    "confidence": 0.5,
    "status": "belief",
    "scope": "pairwise",
    "dependencies": [],
