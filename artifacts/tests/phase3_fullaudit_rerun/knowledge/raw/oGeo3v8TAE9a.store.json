  "nnWQ4SX5ee3s": {
    "proposition_id": "nnWQ4SX5ee3s",
    "text": "A fraction $\\frac{1}{n}$ in its simplest form is a terminating decimal if and only if the denominator $n$ (after all common factors with the numerator have been canceled) is of the form $2^a \\times 5^b$, where $a$ and $b$ are non-negative integers",
    "source_node": "GkGG",
    "source_role": "Knowlegable Expert",
    "confidence": 0.5,
