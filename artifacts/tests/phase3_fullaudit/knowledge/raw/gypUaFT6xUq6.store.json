    }
  },
  "qpzLACQd4VVw": {
    "proposition_id": "qpzLACQd4VVw",
    "text": "Let (m * v)/E  = C",
    "source_node": "qFTn",
    "source_role": "Knowlegable Expert",
    "confidence": 0.5,
    "status": "belief",
    "scope": "pairwise",
