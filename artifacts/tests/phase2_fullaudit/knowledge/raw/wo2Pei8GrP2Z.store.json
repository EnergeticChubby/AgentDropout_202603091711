    "metadata": {
      "round": 0
    }
  },
  "ne6ETCbiR4HD": {
    "proposition_id": "ne6ETCbiR4HD",
    "text": "This is necessary for a program to be shared by several users in a multiprogrammed system, because the operating system may need to interrupt and restart the program multiple times",
    "source_node": "RspS",
    "source_role": "Knowlegable Expert",
    "confidence": 0.5,
