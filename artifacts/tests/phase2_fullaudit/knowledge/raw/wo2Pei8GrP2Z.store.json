  "HQF5P2mHDAds": {
    "proposition_id": "HQF5P2mHDAds",
    "text": "A reentrant program is one that can be interrupted at any time and started again at the point where it was interrupted, without losing its state",
    "source_node": "RspS",
    "source_role": "Knowlegable Expert",
    "confidence": 0.5,
    "status": "belief",
    "scope": "pairwise",
    "dependencies": [],
