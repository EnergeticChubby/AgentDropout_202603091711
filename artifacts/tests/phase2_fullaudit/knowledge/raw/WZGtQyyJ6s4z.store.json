    "metadata": {
      "round": 0
    }
  },
  "89y32UUtvimD": {
    "proposition_id": "89y32UUtvimD",
    "text": "ii) If it is desired that the distributional properties of the data in the experiment are known exactly, bootstrapping may not be preferred since it relies on resampling from the actual sample data",
