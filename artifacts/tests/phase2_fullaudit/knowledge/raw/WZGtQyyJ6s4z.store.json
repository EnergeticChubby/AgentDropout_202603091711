    "metadata": {
      "round": 0
    }
  },
  "BvLkvsU8UF3d": {
    "proposition_id": "BvLkvsU8UF3d",
    "text": "i) If it is desired that the distributional properties of the data in the experiment are the same as those of some actual data, bootstrapping can be preferred because it allows us to use our sample data to generate multiple samples and get an approximated distribution of the statistic",
    "source_node": "9DvT",
    "source_role": "Knowlegable Expert",
    "confidence": 0.5,
    "status": "belief",
    "scope": "pairwise",
    "dependencies": [],
