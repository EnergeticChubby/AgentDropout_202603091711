  "CohGtcZAJuMw": {
    "proposition_id": "CohGtcZAJuMw",
    "text": "Considering the key entities, bootstrapping is a statistical method that allows us to resample the data and get sampling distribution for a statistic with replacement, allowing us to simulate different possible outcomes based on our available data",
    "source_node": "9DvT",
    "source_role": "Knowlegable Expert",
    "confidence": 0.5,
    "status": "belief",
    "scope": "pairwise",
    "dependencies": [],
