    "run_cmds": [
      "/workspace/.venv/bin/python experiments/run_svamp.py --dataset_json datasets/SVAMP/split_seed42/svamp_val.json --train_json datasets/SVAMP/split_seed42/svamp_train.json --split_meta_json datasets/SVAMP/split_seed42/split_meta.json --result_dir result/gz10-v3/SVAMP --phase_name phase1quickprep --llm_name MiniMax-M2.5 --mode FullConnected --agent_nums 5 --batch_size 20 --num_iterations 1 --imp_per_iterations 1 --pruning_rate 0.10 --num_rounds 2 --train_sample_size 5 --eval_sample_size 20 --optimized_spatial --optimized_temporal --diff --dec --state_aware_node --state_aware_edge --lambda_repeat 0.1 --lambda_consensus 0.1 --lambda_capacity 0.05 --gamma_repeatflow 0.1 --gamma_echo 0.1 --gamma_capacityflow 0.05 --telemetry_output result/gz10-v3/phase1quick/telemetry_{attempt}.jsonl --observer_output result/gz10-v3/phase1quick/observer_{attempt}.jsonl",
