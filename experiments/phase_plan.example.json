[
  {
    "name": "phase0-baseline",
    "benchmark_type": "svamp",
    "result_glob": "result/SVAMP/svamp_phase0_*.json",
    "max_attempts": 1,
    "tasks": [
      "re-read-plan",
      "build-svamp-split",
      "run-phase0-baseline",
      "collect-artifacts"
    ],
    "run_cmds": [
      "/workspace/.venv/bin/python dataset/svamp_split.py --seed 42 --output_dir datasets/SVAMP/split_seed42",
      "/workspace/.venv/bin/python experiments/run_svamp.py --dataset_json datasets/SVAMP/split_seed42/svamp_test.json --train_json datasets/SVAMP/split_seed42/svamp_train.json --phase_name phase0 --llm_name MiniMax-M2.5 --mode FullConnected --agent_nums 5 --batch_size 40 --num_iterations 2 --imp_per_iterations 1 --pruning_rate 0.10 --num_rounds 2 --optimized_spatial --optimized_temporal --diff --dec"
    ]
  },
  {
    "name": "phase1-state-aware-node-edge",
    "benchmark_type": "svamp",
    "result_glob": "result/SVAMP/svamp_phase1_*.json",
    "max_attempts": 5,
    "tasks": [
      "re-read-plan",
      "run-state-aware-training",
      "compare-with-phase0",
      "retry-if-not-improved"
    ],
    "run_cmds": [
      "/workspace/.venv/bin/python experiments/run_svamp.py --dataset_json datasets/SVAMP/split_seed42/svamp_val.json --train_json datasets/SVAMP/split_seed42/svamp_train.json --phase_name phase1 --llm_name MiniMax-M2.5 --mode FullConnected --agent_nums 5 --batch_size 40 --num_iterations 2 --imp_per_iterations 1 --pruning_rate 0.10 --num_rounds 2 --optimized_spatial --optimized_temporal --diff --dec --state_aware_node --state_aware_edge --lambda_repeat 0.1 --lambda_consensus 0.1 --lambda_capacity 0.05 --gamma_repeatflow 0.1 --gamma_echo 0.1 --gamma_capacityflow 0.05 --telemetry_output result/gz10-v3/phase1/telemetry_{attempt}.jsonl --observer_output result/gz10-v3/phase1/observer_{attempt}.jsonl"
    ]
  }
]
